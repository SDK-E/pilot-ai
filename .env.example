# Postgres connection string for Mastra-owned runtime tables (Neon). Use a
# separate database per environment; never point this at Pilot's own
# application database. `neon link` in this directory populates it.
DATABASE_URL=postgresql://user:password@host/pilot-ai-your-environment

# Log level for the shared runtime logger: debug, info, warn, error, or silent.
PILOT_LOG_LEVEL=info

# WorkOS M2M application Pilot authenticates with (client_credentials grant).
# Verified against this AuthKit environment's JWKS; not secret — pilot-ai
# never holds the client secret, only pilot (the caller) does.
WORKOS_M2M_AUTHKIT_DOMAIN=https://modern-technology-87-local.authkit.app
WORKOS_M2M_CLIENT_ID=client_01M2GTBXNA4VZ2ZAGD5VB0Q1CB

PILOT_ACTIVITY_CALLBACK_URL=https://pilot.example.com/api/runtime/activity

# skills.sh API authentication (runtime skill preflight search). Only
# available when actually deployed on Vercel; unset elsewhere (e.g. Render)
# just disables that one preflight step, it does not fail the turn.
# For local development: vercel link && vercel env pull
VERCEL_OIDC_TOKEN=

# E2B authentication for the code-sandbox tool. Create a key at
# e2b.dev/dashboard (or `e2b auth login` with the E2B CLI) under the
# workspace this deployment should provision sandboxes in.
E2B_API_KEY=

# Redis endpoint backing the three platform circuit breakers
# (webSearchEnabled, codeSandboxEnabled, connectorsEnabled — see
# feature-flags.ts), independent of Pilot's own per-org/per-user preferences
# and Pilot's own database, so a compromised Pilot admin account can't flip
# them. Toggled by writing flag:<name> keys directly, no redeploy needed. A
# missing/unreachable store fails closed (all disabled).
PILOT_FEATURE_FLAGS_REDIS_URL=

# development, preview, or production — set per deployment (e.g. per Render
# service). Read alongside VERCEL_ENV wherever the runtime needs to know
# which deployment it's running as. Unset means "development".
PILOT_DEPLOY_ENVIRONMENT=

# Tuning profile for the public-web tools: fast, balanced, deep, or test.
PILOT_PROFILE=balanced
PILOT_SEARCH_CACHE_TTL_MS=300000
PILOT_FETCH_CACHE_TTL_MS=300000
PILOT_FETCH_TIMEOUT_MS=20000
PILOT_CIRCUIT_BREAKER_FAILURES=3
PILOT_CIRCUIT_BREAKER_BLOCK_MS=60000

# Shared Redis endpoint (rediss:// for managed TLS) required before a Work
# run can claim reconnectable observation across Vercel instances. Keep
# server-only. Required to run durable Pilot Work.
PILOT_WORK_REDIS_URL=rediss://user:password@host:port
# Defaults to one hour; minimum 60.
PILOT_WORK_CACHE_TTL_SECONDS=3600
