# Kilo Gateway API key — get yours at app.kilo.ai
KILO_API_KEY=your-kilocode-api-key

# LangSearch API key — get yours at langsearch.com/dashboard
LANGSEARCH_API_KEY=your-langsearch-api-key

# Stagehand / Browserbase — https://browserbase.com
BROWSERBASE_API_KEY=your-browserbase-api-key

# Mastra platform
MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PROJECT_ID=

PILOT_PROFILE=balanced

PILOT_MAIN_MAX_STEPS=80
PILOT_SUBAGENT_MAX_STEPS=35

PILOT_MAIN_TOKEN_LIMIT=120000
PILOT_SUBAGENT_TOKEN_LIMIT=94000

PILOT_OBSERVATIONAL_MEMORY=true
PILOT_OBSERVATION_MESSAGE_TOKENS=24000

PILOT_SEARCH_CACHE_TTL_MS=300000
PILOT_FETCH_CACHE_TTL_MS=300000

# smoke | regression | deep
PILOT_EVAL_MODE=smoke

PILOT_EVAL_CONCURRENCY=1

# Smoke is hard-capped at 50 seconds in the experiment runner.
PILOT_EVAL_TIMEOUT_MS=50000

PILOT_EVAL_MAX_RETRIES=0