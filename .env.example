# Kilo Gateway API key — get yours at app.kilo.ai
KILO_API_KEY=your-kilocode-api-key

# Turso LibSQL URL and token for Mastra-owned runtime tables. Use a separate
# database for each environment; never point this at Pilot's application Neon DB.
TURSO_DATABASE_URL=libsql://pilot-ai-your-environment.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Log level for the shared runtime logger: debug, info, warn, error, or silent.
PILOT_LOG_LEVEL=info

# Enables the hardened public-web search capability in the deployed runtime.
PILOT_ENABLE_WEB_SEARCH=false
PILOT_ACTIVITY_CALLBACK_URL=https://pilot.example.com/api/runtime/activity

# Enables audited, request-scoped skill discovery in the deployed runtime.
# It remains fail-closed unless the protected callback and Vercel OIDC are also
# configured. Only a safe selected-skill label reaches Pilot activity records.
PILOT_ENABLE_RUNTIME_SKILLS=false

# LangSearch API key — get yours at langsearch.com/dashboard
LANGSEARCH_API_KEY=your-langsearch-api-key

# skills.sh API authentication.
# Enable Vercel OIDC Federation for the deployed project.
# For local development: vercel link && vercel env pull
VERCEL_OIDC_TOKEN=

# Tuning profile for the public-web tools: fast, balanced, deep, or test.
PILOT_PROFILE=balanced
PILOT_SEARCH_CACHE_TTL_MS=300000
PILOT_FETCH_CACHE_TTL_MS=300000
