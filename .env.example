# Kilo Gateway API key — get yours at app.kilo.ai
KILO_API_KEY=your-kilocode-api-key

# Neon PostgreSQL URL for Mastra-owned runtime tables. This must be the
# matching environment's Pilot database and is deliberately separate from
# Pilot's application DATABASE_URL variable.
PILOT_MASTRA_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Set only for local research-agent development. The deployed Pilot Conversation
# function does not import the research agent or its browser and web tools.
PILOT_ENABLE_RESEARCH=false

# Required only when PILOT_ENABLE_RESEARCH=true. Use development-only
# storage outside src/ so the Research Agent's local data cannot be deployed.
MASTRA_DATABASE_URL=file:/absolute/path/to/pilot-research/mastra.db
MASTRA_EDITOR_DATABASE_URL=file:/absolute/path/to/pilot-research/editor.db
MASTRA_MEMORY_DATABASE_URL=file:/absolute/path/to/pilot-research/memory.db

# LangSearch API key — get yours at langsearch.com/dashboard
LANGSEARCH_API_KEY=your-langsearch-api-key

# Stagehand / Browserbase — https://browserbase.com
BROWSERBASE_API_KEY=your-browserbase-api-key

# skills.sh API authentication.
# Enable Vercel OIDC Federation for the deployed project.
# For local development: vercel link && vercel env pull
VERCEL_OIDC_TOKEN=

# Mastra platform
MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PROJECT_ID=

PILOT_PROFILE=balanced

PILOT_MAIN_MAX_STEPS=80
PILOT_SUBAGENT_MAX_STEPS=35

PILOT_MAIN_TOKEN_LIMIT=120000
PILOT_SUBAGENT_TOKEN_LIMIT=94000

PILOT_OBSERVATIONAL_MEMORY=true
PILOT_OBSERVATION_MESSAGE_TOKENS=24000

PILOT_SEARCH_CACHE_TTL_MS=300000
PILOT_FETCH_CACHE_TTL_MS=300000

# smoke | regression | deep
PILOT_EVAL_MODE=smoke

PILOT_EVAL_CONCURRENCY=1

# Smoke is hard-capped at 50 seconds in the experiment runner.
PILOT_EVAL_TIMEOUT_MS=50000

PILOT_EVAL_MAX_RETRIES=0
