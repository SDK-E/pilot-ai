# Kilo Gateway API key — get yours at app.kilo.ai
KILO_API_KEY=your-kilocode-api-key

# Turso LibSQL URL and token for Mastra-owned runtime tables. Use a separate
# database for each environment; never point this at Pilot's application Neon DB.
TURSO_DATABASE_URL=libsql://pilot-ai-your-environment.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Log level for the shared runtime logger: debug, info, warn, error, or silent.
PILOT_LOG_LEVEL=info

# WorkOS M2M application Pilot authenticates with (client_credentials grant).
# Verified against this AuthKit environment's JWKS; not secret — pilot-ai
# never holds the client secret, only pilot (the caller) does.
WORKOS_M2M_AUTHKIT_DOMAIN=https://modern-technology-87-local.authkit.app
WORKOS_M2M_CLIENT_ID=client_01M2GTBXNA4VZ2ZAGD5VB0Q1CB

# Enables the hardened public-web search capability in the deployed runtime.
PILOT_ENABLE_WEB_SEARCH=false
PILOT_ACTIVITY_CALLBACK_URL=https://pilot.example.com/api/runtime/activity

# LangSearch API key — get yours at langsearch.com/dashboard
LANGSEARCH_API_KEY=your-langsearch-api-key

# skills.sh API authentication.
# Enable Vercel OIDC Federation for the deployed project.
# For local development: vercel link && vercel env pull
VERCEL_OIDC_TOKEN=

# Platform circuit breaker for all 8 connector tools (GitHub, Google Drive,
# Gmail, Slack, Notion, Linear, Vercel, Monday.com), independent of Pilot's
# own per-org/per-user connection state.
PILOT_ENABLE_CONNECTORS=false

# Platform circuit breaker for the code-sandbox tool, independent of any
# organization's own codeSandboxEnabled preference.
PILOT_ENABLE_CODE_SANDBOX=false

# Tuning profile for the public-web tools: fast, balanced, deep, or test.
PILOT_PROFILE=balanced
PILOT_SEARCH_CACHE_TTL_MS=300000
PILOT_FETCH_CACHE_TTL_MS=300000

# Shared Redis endpoint (rediss:// for managed TLS) required before a Work
# run can claim reconnectable observation across Vercel instances. Keep
# server-only. Required to run durable Pilot Work.
PILOT_WORK_REDIS_URL=rediss://user:password@host:port
# Defaults to one hour; minimum 60.
PILOT_WORK_CACHE_TTL_SECONDS=3600

# Optional GitHub token to raise the unauthenticated rate limit for the
# public-web GitHub tool. Never required.
GITHUB_TOKEN=
