{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm typecheck",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/v1/:path*"
    }
  ],
  "functions": {
    "api/v1/chat/completions.ts": {
      "maxDuration": 90
    }
  }
}
