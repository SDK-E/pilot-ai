{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm start)",
      "Bash(pnpm test)",
      "Bash(pnpm test -- *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm knip)",
      "Bash(pnpm check)",
      "Bash(pnpm verify:memory)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm install --frozen-lockfile && pnpm typecheck"
          }
        ]
      }
    ]
  }
}
