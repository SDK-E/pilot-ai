{
  "name": "pilot-ai",
  "version": "1.0.0",
  "description": "Pilot and Pilot Research runtime boundary.",
  "private": true,
  "scripts": {
    "dev": "mastra dev --dir src",
    "dev:research": "PILOT_ENABLE_DEVELOPMENT_RESEARCH=true mastra dev --dir src",
    "build": "mastra build --dir src",
    "build:research": "PILOT_ENABLE_DEVELOPMENT_RESEARCH=true mastra build --dir src",
    "start": "mastra start",
    "test": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --production",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm knip",
    "verify:memory": "tsx src/conversation/verify-memory.ts",
    "eval:seed": "PILOT_ENABLE_RESEARCH=true tsx src/research/evals/seed.ts",
    "eval": "PILOT_ENABLE_RESEARCH=true tsx src/research/evals/run.ts",
    "eval:smoke": "PILOT_ENABLE_RESEARCH=true PILOT_EVAL_MODE=smoke tsx src/research/evals/run.ts",
    "eval:regression": "PILOT_ENABLE_RESEARCH=true PILOT_EVAL_MODE=regression tsx src/research/evals/run.ts",
    "eval:deep": "PILOT_ENABLE_RESEARCH=true PILOT_EVAL_MODE=deep tsx src/research/evals/run.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "imports": {
    "#conversation/*": "./src/conversation/*.js",
    "#research/*": "./src/research/*.js",
    "#runtime/cache": "./src/runtime/cache/index.js",
    "#runtime/research-cache": "./src/runtime/research-cache/index.js",
    "#runtime/research-config": "./src/runtime/research-config/index.js",
    "#runtime/research-config/research-agent/storage": "./src/runtime/research-config/research-agent/storage.js",
    "#runtime/research-processors": "./src/runtime/research-processors/index.js",
    "#runtime/research-storage": "./src/runtime/research-storage/index.js",
    "#runtime/scorers": "./src/runtime/scorers/index.js",
    "#runtime/schemas": "./src/runtime/schemas/index.js",
    "#runtime/storage": "./src/runtime/storage/index.js",
    "#runtime/tools": "./src/runtime/tools/index.js",
    "#runtime/skills": "./src/runtime/skills/index.js",
    "#runtime/*": "./src/runtime/*.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@mastra/core": "1.64.0",
    "@mastra/libsql": "^1.22.3",
    "@mastra/memory": "^1.28.2",
    "@mastra/redis": "1.4.4",
    "ioredis": "6.0.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "mastra": "1.27.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@browserbasehq/stagehand": "^4.0.2",
    "@eslint/js": "^10.0.1",
    "@mastra/duckdb": "^1.6.4",
    "@mastra/editor": "^0.14.3",
    "@mastra/evals": "^1.10.0",
    "@mastra/fastembed": "^1.3.1",
    "@mastra/observability": "^1.17.5",
    "@types/node": "latest",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "knip": "6.34.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.9"
  }
}
