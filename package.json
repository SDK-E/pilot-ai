{
  "name": "pilot-ai",
  "version": "1.0.0",
  "description": "Mastra runtime behind Pilot: the base agent and its chat, work, and code kinds, memory, and the protected runtime API.",
  "private": true,
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "test": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --production",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm knip",
    "verify:memory": "tsx scripts/verify-memory.ts",
    "env:pull": "bash scripts/pull-env.sh .env.local development",
    "env:pull:preview": "bash scripts/pull-env.sh .env.local preview",
    "env:pull:production": "bash scripts/pull-env.sh .env.local production",
    "env:push": "bash scripts/push-env.sh .env.local development",
    "env:push:preview": "bash scripts/push-env.sh .env.local preview",
    "env:push:production": "bash scripts/push-env.sh .env.local production",
    "env:sync": "bash scripts/sync-env.sh .env.local development",
    "env:sync:preview": "bash scripts/sync-env.sh .env.local preview",
    "env:sync:production": "bash scripts/sync-env.sh .env.local production",
    "env:check": "bash scripts/check-env.sh development .env.local",
    "env:check:preview": "bash scripts/check-env.sh preview",
    "env:check:production": "bash scripts/check-env.sh production"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@mastra/core": "1.64.0",
    "@mastra/libsql": "^1.22.3",
    "@mastra/memory": "^1.28.2",
    "@mastra/redis": "1.4.4",
    "@vercel/edge-config": "^1.5.1",
    "@vercel/sandbox": "^3.3.0",
    "ioredis": "6.0.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "mastra": "1.27.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "26.5.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "knip": "6.34.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.9"
  }
}
