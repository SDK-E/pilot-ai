{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "outDir": "dist",
    "ignoreDeprecations": "6.0",
    "paths": {
      "#runtime/*": ["/src/runtime/*"],
      "#runtime/cache": ["/src/runtime/cache"],
      "#runtime/cache/*": ["/src/runtime/cache/*"],
      "#runtime/scorers": ["/src/runtime/scorers"],
      "#runtime/scorers/*": ["/src/runtime/scorers/*"],
      "#runtime/schemas": ["/src/runtime/schemas"],
      "#runtime/schemas/*": ["/src/runtime/schemas/*"],
      "#runtime/storage": ["/src/runtime/storage"],
      "#runtime/storage/*": ["/src/runtime/storage/*"],
      "#runtime/tools": ["/src/runtime/tools"],
      "#runtime/tools/*": ["/src/runtime/tools/*"],
      "#runtime/tools/search/*": ["/src/runtime/tools/search/*"],
      "#runtime/skills": ["/src/runtime/skills"],
      "#runtime/skills/*": ["/src/runtime/skills/*"],
      "#research/*": ["/src/research/*"],
      "#conversation/*": ["/src/conversation/*"]
    }
  },
  "include": ["src/**/*"]
}
